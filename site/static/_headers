# Cloudflare Workers static assets: headers by path (this file is not served).

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The install scripts and the update feed, which deploy (README.md) adds.
# The latest script changes with each release; a version's never does.
/install.sh
  Content-Type: text/plain; charset=utf-8
  ! Cache-Control
  Cache-Control: public, max-age=300

/install/*
  Content-Type: text/plain; charset=utf-8
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/latest.json
  Content-Type: application/json
  ! Cache-Control
  Cache-Control: public, max-age=300
