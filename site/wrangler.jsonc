// binbun.org on Cloudflare: a Worker with static assets only (no script),
// deployed by .github/workflows/site.yml from Zola's output.
{
  "name": "binbun-org",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "binbun.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
