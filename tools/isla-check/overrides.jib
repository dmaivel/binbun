// CONSTRAINED UNPREDICTABLE choices binbun makes (all deterministic; every
// other case stays the model's unknown choice):
// - WBOVERLAPST, a store with writeback whose base is a data register
//   (`str x1, [x1], #8`): Constraint_NONE, the register's original value
//   is stored (L0 reads operands before writing any).
// - WBOVERLAPLD, a load with writeback into its base (`ldrsw x1, [x1], #4`,
//   decoded for the 64-bit sign-extending loads): Constraint_WBSUPPRESS,
//   the base holds the loaded value (the runtime drops the writeback).
// - DATAOVERLAP, a store exclusive whose status register is a data
//   register (`stxr w1, x1, [x2]`): Constraint_NONE, the original value is
//   stored, as qemu does.
// - BASEOVERLAP, a store exclusive whose status register is the base
//   (`stxr w2, x1, [x2]`): Constraint_NONE, the original address is used,
//   as qemu does.
fn zConstrainUnpredictable(zwhich) {
  zbinbun_choice : %enum zConstraint;
  jump @neq(zUnpredictable_WBOVERLAPST, zwhich) goto 4;
  zbinbun_choice = zConstraint_NONE;
  goto 14;
  jump @neq(zUnpredictable_WBOVERLAPLD, zwhich) goto 7;
  zbinbun_choice = zConstraint_WBSUPPRESS;
  goto 14;
  jump @neq(zUnpredictable_DATAOVERLAP, zwhich) goto 10;
  zbinbun_choice = zConstraint_NONE;
  goto 14;
  jump @neq(zUnpredictable_BASEOVERLAP, zwhich) goto 13;
  zbinbun_choice = zConstraint_NONE;
  goto 14;
  zbinbun_choice = z__UNKNOWN_Constraint(());
  return = zbinbun_choice;
  end;
}

