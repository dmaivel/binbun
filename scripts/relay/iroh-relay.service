# relay.binbun.org's iroh-relay, installed by setup.sh as
# /etc/systemd/system/iroh-relay.service.
[Unit]
Description=iroh relay for binbun (relay.binbun.org)
Documentation=https://github.com/n0-computer/iroh/tree/main/iroh-relay
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=iroh-relay
Group=iroh-relay
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/iroh-relay/config.toml
# /var/lib/iroh-relay: the ACME account and certificates, nothing else.
StateDirectory=iroh-relay
StateDirectoryMode=0700
WorkingDirectory=/var/lib/iroh-relay
Restart=always
RestartSec=5s

# Errors only, into a journal of its own kept in memory (see
# journald@iroh-relay.conf): `journalctl --namespace=iroh-relay`.
Environment=RUST_LOG=error
Environment=NO_COLOR=1
LogNamespace=iroh-relay

# Ports 80 and 443 as an unprivileged user; no other privilege, ever.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

LimitNOFILE=65536
TasksMax=512
MemoryMax=1G

[Install]
WantedBy=multi-user.target
